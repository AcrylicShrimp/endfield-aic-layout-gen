+#[test]
+#[ignore = "set AIC_PLAN24_OUTPUT, AIC_PLAN24_PRODUCT and AIC_PLAN24_DURATION_MS"]
+fn measure_source_generated_input_band() {
+    let root = std::path::PathBuf::from(env!("CARGO_MANIFEST_DIR")).join("../..");
+    let output = std::path::PathBuf::from(std::env::var("AIC_PLAN24_OUTPUT").unwrap());
+    let product = std::env::var("AIC_PLAN24_PRODUCT").unwrap();
+    let duration: u64 = std::env::var("AIC_PLAN24_DURATION_MS")
+        .unwrap()
+        .parse()
+        .unwrap();
+    let config: Value = crate::input::read(
+        &root,
+        std::path::Path::new("tools/native-training/training.json"),
+    )
+    .unwrap();
+    let paths = serde_json::from_value(config["catalogs"].clone()).unwrap();
+    let catalogs = crate::input::load_catalogs(&root, &paths).unwrap();
+    let mut generation: source::Config =
+        serde_json::from_value(config["generation"].clone()).unwrap();
+    generation
+        .products
+        .retain(|candidate| candidate.id == product);
+    assert_eq!(generation.products.len(), 1);
+    generation.products[0].duration_ms = [duration, duration];
+    generation.duration_step_ms = 100;
+    generation.max_facilities = 256;
+    generation.max_attempts = 1;
+    generation.construction.elapsed_ms = std::env::var("AIC_PLAN24_CONSTRUCTION_MS")
+        .map(|value| value.parse().unwrap())
+        .unwrap_or(120_000);
+    generation.episode_setup_ms = generation.construction.elapsed_ms + generation.setup_elapsed_ms;
+    generation.construction.max_steps = 1024;
+    generation.construction.max_placement_attempts = 1024;
+    generation.construction.max_route_searches = 16_384;
+    let mut plan: Value = crate::input::read(&root, &generation.products[0].source).unwrap();
+    plan["target"]["quantity"] = json!(1);
+    plan["target"]["duration_ms"] = json!(duration);
+    let typed: aic_data::recipes::RecipeSourcePlanRequest = serde_json::from_value(plan).unwrap();
+    let throughput = catalogs
+        .data
+        .recipes
+        .calculate_contextual_throughput(&typed);
+    let facilities = aic_data::recipes::calculate_contextual_facility_requirements(&throughput);
+    let wiring =
+        aic_data::recipes::build_contextual_facility_instance_wiring(&throughput, &facilities);
+    let wiring_value = serde_json::to_value(&wiring).unwrap();
+    let instances = wiring_value["nodes"]
+        .as_array()
+        .unwrap()
+        .iter()
+        .filter(|node| node["kind"] == "facility")
+        .count();
+    println!(
+        "plan24_wiring={}",
+        json!({"product":product,"duration_ms":duration,
+        "instances":instances,"success":wiring.success})
+    );
+    if std::env::var_os("AIC_PLAN24_WIRING_ONLY").is_some() {
+        return;
+    }
+    let source = source::Source::load(&root, catalogs, generation, Default::default()).unwrap();
+    let started = std::time::Instant::now();
+    let actual = source.generate(0, &output).unwrap_or_else(|failure| {
+        panic!(
+            "source generation failed after {:.3}s: {failure}",
+            started.elapsed().as_secs_f64()
+        )
+    });
+    let cached = source.generate(0, &output).unwrap();
+    assert_eq!(
+        serde_json::to_value(&cached).unwrap(),
+        serde_json::to_value(&actual).unwrap()
+    );
+    let input = output.join("input.json");
+    let native: source::Generated =
+        crate::input::read(&output, std::path::Path::new("input.json")).unwrap();
+    assert_eq!(
+        serde_json::to_value(&native).unwrap(),
+        serde_json::to_value(&actual).unwrap()
+    );
+    let networks = actual.original.transport_networks.len();
+    let cells = actual
+        .original
+        .transport_networks
+        .iter()
+        .map(|n| n.cells.len())
+        .sum::<usize>();
+    println!(
+        "plan24_source={}",
+        json!({"product":product,"duration_ms":duration,
+        "facilities":actual.original.placements.len(),"networks":networks,"cells":cells,
+        "input_bytes":std::fs::metadata(input).unwrap().len(),
+        "elapsed_s":started.elapsed().as_secs_f64()})
+    );
+}
