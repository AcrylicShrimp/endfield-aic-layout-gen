{
  "schema": "aic-constructive-training-v4",
  "model": {
    "schema": "aic-constructive-attention-model-v2",
    "width": 128,
    "message_rounds": 4
  },
  "optimizer": {
    "adam_backend": "foreach",
    "learning_rate": 0.003,
    "beta1": 0.9,
    "beta2": 0.999,
    "epsilon": 1e-08,
    "clip_epsilon": 0.2,
    "entropy_coefficient": 0.01,
    "imitation_coefficient": 0.0,
    "gradient_clip": 0.5
  },
  "domain": {
    "placement": {
      "minX": 0,
      "minY": 0,
      "maxX": 127,
      "maxY": 127
    },
    "extension_lengths": [1, 2, 4, 8, 16]
  },
  "native": {
    "max_turns": 4096,
    "max_extension": 16
  },
  "reward": {
    "progress_scale": 1.0,
    "full_validation_bonus": 5.0,
    "rejected_penalty": -0.05,
    "unfinished_penalty": -1.0
  },
  "updates": 32,
  "episodes_per_update": 32,
  "ppo_epochs": 4,
  "ppo_minibatch_size": 128,
  "evaluation_episodes": 64,
  "evaluation_interval": 1,
  "evaluation_seed": 700101,
  "problem_seed": 101,
  "gamma": 0.99,
  "gae_lambda": 0.95,
  "advantage_normalization": "standardize",
  "initialization_seed": 101
}
