@@ -0,0 +1,114 @@
+//! Isolated research-build tracing; no effect on candidate ordering or acceptance.
+use super::*;
+use std::io::Write;
+use std::sync::{Mutex, OnceLock};
+
+#[derive(serde::Deserialize)]
+struct Config {
+    edge: String,
+    output: std::path::PathBuf,
+    snapshot: std::path::PathBuf,
+    max_rows: usize,
+}
+
+struct Sink {
+    config: Config,
+    file: std::fs::File,
+    rows: usize,
+}
+
+static SINK: OnceLock<Option<Mutex<Sink>>> = OnceLock::new();
+
+pub(super) fn record(
+    node: &ConstructiveNode,
+    edge: &FacilityInstanceWiringEdge,
+    source: &Attachment,
+    target: &Attachment,
+    transport: TransportKind,
+    occupancy: &Occupancy,
+    mask: &HashSet<(i64, i64)>,
+    axes: &BTreeMap<(i64, i64), bool>,
+    dimensions: (i64, i64),
+    lane: usize,
+    path: Option<&[WorldGridPosition]>,
+) {
+    let Some(sink) = SINK.get_or_init(|| {
+        let file = std::env::var_os("AIC_ATTACHMENT_DIAGNOSTIC")?;
+        let config: Config = serde_json::from_slice(&std::fs::read(file).unwrap()).unwrap();
+        assert!(config.max_rows > 0 && config.max_rows <= 4096);
+        let file = std::fs::OpenOptions::new()
+            .create_new(true)
+            .write(true)
+            .open(&config.output)
+            .unwrap();
+        Some(Mutex::new(Sink {
+            config,
+            file,
+            rows: 0,
+        }))
+    }) else {
+        return;
+    };
+    let mut sink = sink.lock().unwrap();
+    if edge.id != sink.config.edge {
+        return;
+    }
+    assert!(
+        sink.rows < sink.config.max_rows,
+        "Attachment trace limit exceeded"
+    );
+    let inspect = |a: &Attachment| {
+        let p = endpoint(a);
+        let cell = xy(p);
+        let body = occupancy.facilities.contains(&cell);
+        let layer = occupancy.layers[&transport].contains(&cell);
+        serde_json::json!({"attachment": a, "endpoint": p, "facility_blocked": body,
+            "layer_blocked": layer, "masked": mask.contains(&cell),
+            "reservation_only": mask.contains(&cell) && !body && !layer,
+            "crossing": axes.contains_key(&cell),
+            "inside": p.x >= 0 && p.y >= 0 && p.x < dimensions.0 && p.y < dimensions.1})
+    };
+    let row = serde_json::json!({"schema_version":1,"ordinal":sink.rows,"edge":edge.id,"lane":lane,
+        "source":inspect(source),"target":inspect(target),"path_found":path.is_some(),
+        "path_cells":path.map(<[WorldGridPosition]>::len),"members":node.member_instances.len(),
+        "width":dimensions.0,"height":dimensions.1});
+    if sink.rows == 0 {
+        let mut blocked = mask.iter().copied().collect::<Vec<_>>();
+        blocked.sort();
+        let mut facilities = occupancy.facilities.iter().copied().collect::<Vec<_>>();
+        facilities.sort();
+        let mut layer = occupancy.layers[&transport]
+            .iter()
+            .copied()
+            .collect::<Vec<_>>();
+        layer.sort();
+        let crossings = axes
+            .iter()
+            .map(|(&(x, y), &horizontal)| serde_json::json!({"x":x,"y":y,"horizontal":horizontal}))
+            .collect::<Vec<_>>();
+        let snapshot = serde_json::json!({"trial":row,"node":node,"edge":edge,"blocked":blocked,
+            "facility_cells":facilities,"layer_cells":layer,"crossings":crossings,"path":path});
+        let mut file = std::fs::OpenOptions::new()
+            .create_new(true)
+            .write(true)
+            .open(&sink.config.snapshot)
+            .unwrap();
+        serde_json::to_writer(&mut file, &snapshot).unwrap();
+    }
+    serde_json::to_writer(&mut sink.file, &row).unwrap();
+    sink.file.write_all(b"\n").unwrap();
+    sink.rows += 1;
+}
+
+// Only the configured requirement receives the candidate-generation intervention.
+pub(super) fn selected_edge(edge: &str) -> bool {
+    static SELECTED: OnceLock<Option<String>> = OnceLock::new();
+    SELECTED
+        .get_or_init(|| {
+            let file = std::env::var_os("AIC_ATTACHMENT_DIAGNOSTIC")?;
+            let config: Config = serde_json::from_slice(&std::fs::read(file).unwrap()).unwrap();
+            Some(config.edge)
+        })
+        .as_deref()
+        == Some(edge)
+}
